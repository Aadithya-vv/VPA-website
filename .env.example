APP_ORIGIN=http://127.0.0.1:5173
PORT=5173
HOST=127.0.0.1
DATABASE_PATH=./data/vpa.sqlite
STORAGE_DRIVER=local
MEDIA_DIR=./data/media
SESSION_HOURS=8
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain, HOST=0.0.0.0
# Set absolute persistent volume paths and confirm only after mounting them:
# PERSISTENT_DATA_CONFIRMED=true
# TRUST_PROXY=1 (only behind a single trusted reverse proxy)
# For S3-compatible private object storage:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ADMIN_USERNAME and ADMIN_PASSWORD are used only by npm run admin:create/reset.
# Never expose passwords to browser code; remove provisioning values after use.
